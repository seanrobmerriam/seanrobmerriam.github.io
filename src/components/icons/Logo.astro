---
/**
 * ST AI Agency monogram, exactly as drawn in the original design.
 * `light`  — white mark for dark/orange backgrounds (header).
 * `footer` — cream frame with an orange mark for the dark footer.
 */
interface Props {
  variant?: 'light' | 'footer';
}

const { variant = 'light' } = Astro.props;
const c =
  variant === 'footer'
    ? { frame: '#FFF6EC', frameOpacity: '.5', mark: '#FF8A3D', dot: '#1C0F07', dotStroke: '#FF8A3D' }
    : { frame: '#fff', frameOpacity: '.65', mark: '#fff', dot: '#EC5A11', dotStroke: '#fff' };
---

