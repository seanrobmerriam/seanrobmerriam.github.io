---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";

type Props = HTMLAttributes<"section"> &
  Pick<
    ComponentProps<typeof Section>,
    "render" | "theme" | "paddingTop" | "paddingBottom"
  > & {
    /** Hero title. */
    heading: string;
    /** Eyebrow text. */
    eyebrow?: string;
    /** Body text. */
    text?: string;
    /** Button label. Omit to hide the button. */
    buttonLabel?: string;
    /** Button destination. Omit to hide the button. */
    buttonHref?: string;
    /** Secondary button label. Omit to hide the button. */
    secondaryButtonLabel?: string;
    /** Secondary button destination. Omit to hide the button. */
    secondaryButtonHref?: string;
    /** Hero layout. */
    variant?: "default" | "centered";
    /** Heading level. */
    headingTag?: ComponentProps<typeof Heading>["tag"];
  };

const {
  render = true,
  heading,
  eyebrow,
  text,
  buttonLabel,
  buttonHref,
  secondaryButtonLabel,
  secondaryButtonHref,
  variant = "default",
  headingTag = "h1",
  theme = "inherit",
  paddingTop = "large",
  paddingBottom = "large",
  class: className,
  ...rest
} = Astro.props;

const hasPrimaryButton = !!(buttonLabel?.trim() && buttonHref?.trim());
const hasSecondaryButton = !!(
  secondaryButtonLabel?.trim() && secondaryButtonHref?.trim()
);
---

{
  render && heading?.trim() && (
    <Section
      theme={theme}
      paddingTop={paddingTop}
      paddingBottom={paddingBottom}
      class={className}
      {...rest}
    >
      <ContentWrapper centered={variant === "centered"}>
        <Eyebrow>{eyebrow}</Eyebrow>
        <Heading tag={headingTag} variant="display" maxWidth={18}>
          {heading}
        </Heading>
        <Paragraph variant="large" maxWidth={48}>
          {text}
        </Paragraph>
        {(hasPrimaryButton || hasSecondaryButton) && (
          <ButtonWrapper>
            {hasPrimaryButton && (
              <Button element="link" href={buttonHref}>
                {buttonLabel}
              </Button>
            )}
            {hasSecondaryButton && (
              <Button
                element="link"
                href={secondaryButtonHref}
                emphasis="secondary"
              >
                {secondaryButtonLabel}
              </Button>
            )}
          </ButtonWrapper>
        )}
      </ContentWrapper>
    </Section>
  )
}
