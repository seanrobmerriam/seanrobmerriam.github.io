---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/blocks/Hero.astro";
import Projects from "@/components/blocks/Projects.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import MarkdownEditor from "@/components/blocks/MarkdownEditor.astro";
import { projects } from "@/data/projects";
import { services, specialties } from "@/data/portfolio";
import { getCollection } from "astro:content";
import Card from "@/components/item/Card.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const github = "https://github.com/seanrobmerriam";
const focus = [
  {
    number: "01 / Design",
    heading: "Make it clear.",
    text: "Start with the person using it. Find the essential interaction, simplify the path, and give every detail a purpose.",
  },
  {
    number: "02 / Development",
    heading: "Build it thoughtfully.",
    text: "Bring the interface and the systems behind it together. Favor readable code, useful abstractions, and a solid foundation.",
  },
  {
    number: "03 / Exploration",
    heading: "Keep asking questions.",
    text: "Try the unfamiliar. From terminal tools to agent workflows, small experiments are where the next useful idea begins.",
  },
];
---

<BaseLayout
  title="Developer & Designer"
  description="Sean Merriam — software developer and designer. Selected projects, open-source tools, and experiments across the web and developer tooling."
  theme="dark"
>
  <!-- Introduction -->
  <Hero
    id="home"
    variant="sticky-content"
    heading="Your <strong>content</strong>. Your <strong>workflow</strong>. Built with <strong>Astro</strong>."
    text="I build content management systems around the way you publish. From WordPress migrations to Markdown, MDX, and CMS integrations, I create websites that make your content easier to manage."
    buttonLabel="Explore Solutions"
    buttonHref="#work"
    secondaryButtonLabel="Contact"
    secondaryButtonHref="#contact"
    paddingTop="large"
    paddingBottom="large"
    class="heading-accent"
  />

  <!-- WordPress migrations -->
  <Section
    id="wordpress-migrations"
    theme="light"
    aria-labelledby="wordpress-migrations-heading"
  >
    <ContentWrapper variant="sticky-content">
      <div>
        <Eyebrow>WordPress migrations</Eyebrow>
        <Heading id="wordpress-migrations-heading" tag="h2" maxWidth={18}>
          A fresh start for your WordPress site.
        </Heading>
        <Paragraph variant="large" maxWidth={40}>
          Bring your content into a focused Astro website, with a simpler
          foundation and an editing workflow that fits how you work.
        </Paragraph>
        <ButtonWrapper>
          <Button element="link" href="#contact"
            >Let's plan your migration</Button
          >
        </ButtonWrapper>
      </div>
      <div slot="column2">
        <Heading tag="h3" variant="h5">Start with what matters.</Heading>
        <Paragraph>
          Review your pages, posts, media, and plugin features to decide what to
          move, what to simplify, and what needs a new home.
        </Paragraph>
        <Heading tag="h3" variant="h5"
          >Give your content a clear structure.</Heading
        >
        <Paragraph>
          Move posts and pages into Markdown or a suitable CMS, and rebuild
          layouts with reusable components. Keep the writing separate from the
          presentation.
        </Paragraph>
        <Heading tag="h3" variant="h5">Make the move with care.</Heading>
        <Paragraph>
          Map existing URLs, plan redirects, and check metadata, images, links,
          and forms before launch. A migration should account for the details
          people already rely on.
        </Paragraph>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Markdown playground -->
  <Section id="markdown" theme="dark" aria-labelledby="markdown-heading">
    <ContentWrapper>
      <Eyebrow>Markdown Based Content</Eyebrow>
      <Heading id="markdown-heading" tag="h2" class="heading-accent"
        >From <strong>plain </strong>text to a <strong>post.</strong></Heading
      >
      <Paragraph variant="large" maxWidth={44} class="padding-bottom-4">
        Try a heading, a list, or a little emphasis. The preview updates as you
        type.
      </Paragraph>
    </ContentWrapper>
    <MarkdownEditor />
  </Section>

  <!-- Markdoc journal -->
  <Section
    id="journal"
    theme="light"
    aria-labelledby="journal-heading"
    render={posts.length > 0}
  >
    <ContentWrapper variant="sticky-content">
      <Eyebrow>Built with Markdoc</Eyebrow>
      <Heading id="journal-heading" tag="h2">Notes from the work.</Heading>
      <Paragraph variant="large" maxWidth={44}>
        A few thoughts on content, design, and building websites that are easier
        to live with. Written in Markdoc, rendered with Astro.
      </Paragraph>
      <Grid slot="column2">
        {
          posts.map((post) => (
            <Card
              eyebrow={post.data.category}
              heading={post.data.title}
              headingTag="h3"
              text={post.data.description}
              buttonLabel="Read article"
              buttonHref={`/blog/${post.id}/`}
            />
          ))
        }
      </Grid>
    </ContentWrapper>
  </Section>

  <!-- Specialties -->
  <Section id="specialties" theme="light" aria-labelledby="specialties-heading">
    <ContentWrapper variant="sticky-content">
      <div>
        <Eyebrow>Specialties</Eyebrow>
        <Heading id="specialties-heading" tag="h2" maxWidth={16}>
          Where I like to go deep.
        </Heading>
        <Paragraph variant="large" maxWidth={36}>
          The technologies and problem spaces that connect my projects.
        </Paragraph>
      </div>
      <Grid slot="column2" medium={2} role="list" aria-label="Specialties">
        {
          specialties.map((specialty) => (
            <ContentWrapper role="listitem">
              <Heading tag="h3" variant="h5">
                {specialty.heading}
              </Heading>
              <Paragraph>{specialty.text}</Paragraph>
            </ContentWrapper>
          ))
        }
      </Grid>
    </ContentWrapper>
  </Section>

  <!-- About -->
  <Section id="about" aria-labelledby="about-heading">
    <ContentWrapper variant="sticky-content" class="padding-top-small">
      <div>
        <Eyebrow>Behind the work</Eyebrow>
        <Heading id="about-heading-primary" tag="h2" maxWidth={16}
          >A designer's eye —</Heading
        >
        <Heading id="about-heading-secondary" tag="h3"
          >with a developers mindset.</Heading
        >
      </div>
      <div slot="column2">
        <Paragraph variant="large" maxWidth={42}
          >I enjoy the space where design meets engineering: making things that
          feel considered on the surface and make sense underneath.</Paragraph
        >
        <Paragraph maxWidth={48}
          >My projects range from web interfaces to terminal editors and tools
          for AI agents. The thread that connects them is curiosity about how
          things work, and how they could work better.</Paragraph
        >
        <ButtonWrapper
          ><Button element="link" href={github} variant="link"
            >More of what I'm building</Button
          ></ButtonWrapper
        >
      </div>
    </ContentWrapper>
  </Section>

  <!-- Selected work -->
  <Projects
    id="work"
    heading="Built with curiosity."
    text="A selection of open-source tools and experiments. Explore the ideas, read the code, or make something of your own."
    projects={projects}
    theme="light"
    aria-label="Selected projects"
  />

  <!-- Services -->
  <Section id="services" aria-labelledby="services-heading">
    <ContentWrapper variant="sticky-content">
      <div>
        <Eyebrow>Services</Eyebrow>
        <Heading id="services-heading" tag="h2" class="heading-accent">An <strong>idea</strong> worth building?</Heading
        >
        <Paragraph variant="large" maxWidth={44}>
          I can help shape the interface, build the website, or create the tools
          that make it all work.
        </Paragraph>
        <ButtonWrapper>
          <Button element="link" href="#contact"
            >Let's talk about your project</Button
          >
        </ButtonWrapper>
      </div>
      <div slot="column2">
        {
          services.map((service) => (
            <article>
              <Heading tag="h3" variant="h5">
                {service.heading}
              </Heading>
              <Paragraph>{service.text}</Paragraph>
            </article>
          ))
        }
      </div>
    </ContentWrapper>
  </Section>

  <!-- Approach -->
  <Section id="approach" theme="light" aria-labelledby="approach-heading">
    <ContentWrapper variant="sticky-content">
      <Eyebrow>How I work</Eyebrow>
      <Heading id="approach-heading" tag="h2">From idea to interaction.</Heading
      >
      <Paragraph variant="large" maxWidth={44}
        >Good work comes from caring about both the big picture and the small
        details.</Paragraph
      >
      <Grid slot="column2">
        {
          focus.map((item) => (
            <ContentWrapper>
              <Eyebrow>{item.number}</Eyebrow>
              <Heading tag="h3" variant="h4">
                {item.heading}
              </Heading>
              <Paragraph>{item.text}</Paragraph>
            </ContentWrapper>
          ))
        }
      </Grid>
    </ContentWrapper>
  </Section>

  <!-- Contact -->
  <Section id="contact" theme="brand" aria-labelledby="contact-heading">
    <ContentWrapper variant="sticky-content">
      <Heading
        id="contact-heading"
        tag="h2"
        variant="h1"
        maxWidth={16}
        class="brand-500">Good things start with a conversation.</Heading
      >
      <div slot="column2">
        <Paragraph variant="large" maxWidth={42}
          >Have an idea, a question, or a project in mind? Find me on GitHub to
          explore my work and connect.</Paragraph
        >
        <ButtonWrapper>
          <Button element="link" href={github}>Find me on GitHub</Button>
          <Button element="link" href="#work" emphasis="secondary"
            >Back to the work</Button
          >
        </ButtonWrapper>
      </div>
    </ContentWrapper>
  </Section>
</BaseLayout>
