---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import RichText from "@/components/typography/RichText.astro";
import FormattedDate from "@/components/utility/FormattedDate.astro";
import Button from "@/components/Button.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  theme="dark"
>
  <Section>
    <ContentWrapper>
      <Button
        element="link"
        href="/#journal"
        variant="link"
        class="padding-bottom-8"
      >
        <- Back to the journal</Button
      >
      <Eyebrow>{post.data.category}</Eyebrow>
      <Heading tag="h1" variant="h2" maxWidth={22} class="color-brand padding-left-gutter"
        >{post.data.title}</Heading
      >
      <Heading tag="h2" variant="h4" maxWidth={48} class="padding-left-gutter padding-bottom-4"
        >{post.data.description}</Heading
      >
      <Paragraph variant="large" class="padding-top-8" class="color-brand padding-left-gutter">
        {post.data.author} · <FormattedDate date={post.data.pubDate} />
      </Paragraph>
    </ContentWrapper>
    <RichText
      maxWidth={65}
      textWrap="wrap"
      class="alignment-start headings-brand padding-left-gutter line-height-large text-wrap-pretty"
    >
      <Content frontmatter={post.data} />
    </RichText>
  </Section>
</BaseLayout>
